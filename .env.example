# Lead form endpoint (server route below). Leave as is.
VITE_LEAD_ENDPOINT=/api/lead-capture

# AgentLabs (AI voice agent + REST-API add-on) is the lead store: every enquiry becomes an
# AgentLabs contact tagged "anti-ageing-lp". Create the key in AgentLabs -> REST API.
# Server-only secrets — put real values in .env.local / Coolify; never commit them.
AGENTLABS_API_URL=https://agentlabs.169.58.3.64.sslip.io
AGENTLABS_API_KEY=
# Voice agent that calls new leads who agreed to be contacted. Empty = no automatic calls.
AGENTLABS_AGENT_ID=
# Hours (IST) the agent may call; outside them the call is scheduled for the next opening.
AGENTLABS_CALL_WINDOW=10:00-20:30

# WhatsWay (WhatsApp CRM). The welcome template must be approved by Meta; its first body
# variable is the lead's first name. Only sent to leads who ticked WhatsApp consent.
WHATSWAY_API_URL=
WHATSWAY_API_KEY=
WHATSWAY_API_SECRET=
WHATSWAY_CHANNEL_ID=
WHATSWAY_WELCOME_TEMPLATE=
WHATSWAY_TEMPLATE_LANGUAGE=en
# "false" when the template has no {{1}} (first name) variable.
WHATSWAY_TEMPLATE_NAME_PARAM=true
# Optional "|"-separated values for templates with several variables ({name}, {concern}, {preferred_time}).
WHATSWAY_TEMPLATE_PARAMS=

# Clinic dashboard at /dashboard. Unset = dashboard disabled.
DASHBOARD_PASSWORD=
# Optional: separate cookie-signing secret (defaults to one derived from the password).
DASHBOARD_SESSION_SECRET=

# Secure age-transformation endpoint. Receives multipart/form-data with:
# - image: JPG, PNG or WebP file
# - targetStage: baby | child | teen | adult | middle | elderly
# - targetAgeRange: display age range
# Return either an image response or JSON: { "imageUrl": "https://..." }
# Keep provider API keys on the server behind this endpoint, never in a VITE_ variable.
VITE_AGE_TRANSFORM_ENDPOINT=/api/age-transform

# Server-only secret. Put the real value in .env.local; never commit it.
FAL_KEY=

# Google Tag Manager container id (e.g. GTM-XXXXXXX). This is a public identifier, not
# a secret — safe to keep in a VITE_ variable. Create a container at
# https://tagmanager.google.com, then wire a GA4 tag (or Matomo, etc.) inside GTM to
# read the events already pushed to window.dataLayer by src/lib/analytics.ts. Leave
# blank to skip loading GTM entirely (the site still tracks everything into
# window.dataLayer locally — it just has nowhere to send it until this is set).
VITE_GTM_CONTAINER_ID=

# GA4 web stream Measurement ID (e.g. G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=
